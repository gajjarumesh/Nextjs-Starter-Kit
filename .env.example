# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchkit
APP_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-random-string
DEMO_MODE=false

# ── OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (optional: without a key, emails print to the server console)
RESEND_API_KEY=
EMAIL_FROM="LaunchKit <onboarding@resend.dev>"

# ── Stripe (test mode) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BIZ_MONTH=
STRIPE_PRICE_BIZ_YEAR=

# ── Razorpay (test mode) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTH=
RAZORPAY_PLAN_PRO_YEAR=
RAZORPAY_PLAN_BIZ_MONTH=
RAZORPAY_PLAN_BIZ_YEAR=

# ── AI ("mock" costs nothing) ────────────────────────────────────────
AI_DEFAULT_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_SMART=

# ── Marketing site (public values, inlined at build time) ──────────
# Contact address for "Email us", "Support" and the final call to action.
NEXT_PUBLIC_CONTACT_EMAIL=
# Licence checkout links (Gumroad / Lemon Squeezy). A tier's Buy button is hidden while unset.
NEXT_PUBLIC_CHECKOUT_SOLO_URL=
NEXT_PUBLIC_CHECKOUT_TEAM_URL=
NEXT_PUBLIC_CHECKOUT_AGENCY_URL=
# Optional demo video (e.g. /media/launchkit-tour.mp4); captions are read from the sibling .vtt.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# ── Rate limiting (optional in development: in-memory fallback) ──────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
